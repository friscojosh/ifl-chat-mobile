APP_NAME="IFL Chat"
APP_SCHEME=iflchat
APP_AUTH_SCHEME=iflchatauth
APP_AUTH_SCHEME_BETA=iflchatauthdev
BETA_BUILD=false
BUILD_FOR_RELEASE=true
COMMIT_CHANGES_TO_GIT=false
MAIN_APP_IDENTIFIER=com.iflgm.chat
EXTENSION_APP_IDENTIFIER=com.iflgm.chat.MattermostShare
NOTIFICATION_SERVICE_IDENTIFIER=com.iflgm.chat.NotificationService
IOS_APP_GROUP=group.com.iflgm.chat
IOS_ICLOUD_CONTAINER=iCloud.com.iflgm.chat
IOS_BUILD_EXPORT_METHOD=app-store
MATCH_APP_IDENTIFIER=com.iflgm.chat.NotificationService,com.iflgm.chat.MattermostShare,com.iflgm.chat
MATCH_TYPE=appstore
MATCH_READONLY=true
MATCH_SHALLOW_CLONE=true
MATCH_SKIP_DOCS=true
MATCH_GIT_URL=git@github.com:friscojosh/ifl-chat-signing.git
SYNC_PROVISIONING_PROFILES=true
PILOT_SKIP_WAITING_FOR_BUILD_PROCESSING=true
REPLACE_ASSETS=true
SHOW_ONBOARDING=false
SHOW_REVIEW=false
SENTRY_ENABLED=false
COLLECT_NETWORK_METRICS=false
INTUNE_ENABLED=false
ANDROID_BUILD_TASK=assemble,bundle
UNIVERSAL_APK=true
SUPPLY_PACKAGE_NAME=com.iflgm.chat
SUPPLY_TRACK=internal
SUPPLY_VALIDATE_ONLY=false
